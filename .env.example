# Agent Town simulation engine (apps/server) — copy to .env and fill in.
# Vite only exposes VITE_-prefixed vars to the browser, so GEMINI_API_KEY is
# server-only and never reaches the frontend bundle.

# Required for a real (LLM-authored) bake or for Live Mode. If absent, the
# simulation runs in deterministic OFFLINE mode (zero API calls, zero cost).
GEMINI_API_KEY=

# --- model selection (cost) ---
# flash-lite is the cheapest capable model; override only if you know the cost.
GEMINI_MODEL=gemini-2.5-flash-lite
# Embeddings default to a free deterministic local hash (the embedding API is the
# rate-limit bottleneck in a bake). Set GEMINI_REMOTE_EMBED=1 for real vectors.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_REMOTE_EMBED=0

# --- live-mode cost guards (see requirements.md R9) ---
LIVE_MAX_AGENTS=6
LIVE_TOKEN_BUDGET=50000
LIVE_TIMEOUT_SECONDS=600

# --- in-character NPC/traveler chat (POST /ask) ---
# Every NPC the player talks to answers in-character via Gemini, grounded in the
# KB. LIVE whenever GEMINI_API_KEY is set (on by default); set to 0 to force off.
# The frontend calls this server (FEATURES.liveNpcChat + VITE_AGENT_SERVER, which
# defaults to http://localhost:8001 — run the server with `serve --port 8001`).
TAVERN_QA_ENABLED=1
TAVERN_ANSWER_MAX_TOKENS=220     # output cap per answer
TAVERN_ANSWER_TIMEOUT=9          # per-call seconds; the route adds a small margin
TAVERN_QUESTION_MAX_CHARS=280    # input is hard-trimmed to this
TAVERN_RATE_PER_MIN=5            # per-IP question budget / minute
TAVERN_RATE_PER_HOUR=40          # per-IP question budget / hour
TAVERN_REQUEST_TOKEN_CAP=8000    # per-request token backstop (kill switch)
# Comma-separated EXTRA origins allowed to call the API. The deployed site and
# localhost are always allowed (config.DEFAULT_ORIGINS), as is each entry's
# www/apex twin, so this is only needed for a new domain or preview host.
TAVERN_ALLOWED_ORIGINS=
