# Agent Town simulation engine (apps/server) — copy to .env and fill in.
# Vite only exposes VITE_-prefixed vars to the browser, so GEMINI_API_KEY is
# server-only and never reaches the frontend bundle.

# Required for a real (LLM-authored) bake or for Live Mode. If absent, the
# simulation runs in deterministic OFFLINE mode (zero API calls, zero cost).
GEMINI_API_KEY=

# --- model selection (cost) ---
# flash-lite is the cheapest capable model; override only if you know the cost.
GEMINI_MODEL=gemini-2.5-flash-lite
# Embeddings default to a free deterministic local hash (the embedding API is the
# rate-limit bottleneck in a bake). Set GEMINI_REMOTE_EMBED=1 for real vectors.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_REMOTE_EMBED=0

# --- live-mode cost guards (see requirements.md R9) ---
LIVE_MAX_AGENTS=6
LIVE_TOKEN_BUDGET=50000
LIVE_TIMEOUT_SECONDS=600
